# Copia este fichero a config.env y rellénalo. config.env no se sube a git.

# Tema de ntfy al que estás suscrito en la app del móvil. Inventa uno largo y raro:
# cualquiera que lo conozca puede leer los avisos (sólo dicen qué VPS hay disponible).
NTFY_TOPIC=

# Centro donde tienes (o vas a tener) el VPS-1. Si aparece aquí, el aviso es de prioridad alta.
HOME_DC=eu-west-gra

# Planes a vigilar (códigos del catálogo de OVH España).
#PLANS="vps-2027-model2 vps-2027-model3"

# Centros a vigilar. Por defecto, todos los europeos.
#DATACENTERS="eu-west-gra eu-west-rbx eu-west-sbg eu-central-waw eu-west-lim eu-west-eri eu-south-mil"

# Hetzner Cloud: token de SÓLO LECTURA (Hetzner Console → tu proyecto → Security →
# API tokens → Read). Vacío = no se vigila Hetzner.
HCLOUD_TOKEN=
# Tipos y ubicaciones a vigilar. cx33 = 4 vCPU x86, 8 GB. Sin ARM (los cax).
#HETZNER_TYPES="cx33"
#HETZNER_LOCATIONS="fsn1 nbg1 hel1"
